# ── Server ─────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
# Public address of this app (used for links inside emails)
BASE_URL=https://support.example.com
# Shown in the header, page titles and every email
APP_NAME=Support Desk
# REQUIRED in production: a long random string (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# ── MySQL / MariaDB ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=support_tickets

# ── Email (optional; without it tickets still work, emails are skipped and logged) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Support Desk <support@example.com>"
# Staff address that receives "new ticket" and "customer replied" alerts
ADMIN_EMAIL=

# ── Behaviour ──────────────────────────────────────────────────────────
# Hours of silence before a ticket is closed automatically
SUPPORT_TICKET_TTL_HOURS=24
# Wording on the form and in emails: "we reply within ..."
SUPPORT_REPLY_WITHIN=24 hours
# 0 = nobody can create their own account (tickets can still be filed without one)
ALLOW_REGISTRATION=1
